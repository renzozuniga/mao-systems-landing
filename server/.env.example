# Server
PORT=5000
NODE_ENV=development

# CORS — origen permitido (frontend)
CLIENT_ORIGIN=http://localhost:3000
# Producción: CLIENT_ORIGIN=https://maosystems.io

# Correo de destino para los mensajes del formulario
CONTACT_TO_EMAIL=maosystems.dev@gmail.com

# Resend — API HTTPS (SDK oficial, más confiable que SMTP)
RESEND_API_KEY=tu-api-key-de-resend

# Remitente del correo. Mientras no verifiques un dominio propio en Resend,
# debe ser onboarding@resend.dev (modo sandbox — solo entrega al email de
# la cuenta de Resend).
RESEND_FROM_EMAIL=onboarding@resend.dev
