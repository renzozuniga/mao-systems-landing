# Server
PORT=5000
NODE_ENV=development

# CORS — origen permitido (frontend)
CLIENT_ORIGIN=http://localhost:3000
# Producción: CLIENT_ORIGIN=https://maosystems.io

# Nodemailer — correo de destino
CONTACT_TO_EMAIL=rzuniga@maosystems.io

# Proveedor SMTP (opción A: Gmail App Password)
