# Server
PORT=5000
NODE_ENV=development

# CORS — origen permitido (frontend)
CLIENT_ORIGIN=http://localhost:3000
# Producción: CLIENT_ORIGIN=https://maosystems.io

# Correo de destino para los mensajes del formulario
CONTACT_TO_EMAIL=rzuniga@maosystems.io

# Zoho Mail SMTP — correo corporativo rzuniga@maosystems.io
# Puerto 465 = SSL directo (recomendado)
# Puerto 587 = STARTTLS (alternativa)
SMTP_HOST=smtp.zoho.com
SMTP_PORT=465
SMTP_USER=rzuniga@maosystems.io
SMTP_PASS=tu-contrasena-o-app-password
